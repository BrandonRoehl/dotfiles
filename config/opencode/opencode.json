{
    "$schema": "https://opencode.ai/config.json",
    "share": "disabled",
    "lsp": true,
    "display": {
        "thinking": "show"
    },
    // V1 "enabled_providers" equivalent: deny every provider, then allow the enabled ones.
    // "policies": [
    //     { "action": "provider.use", "resource": "*", "effect": "deny" },
    //     { "action": "provider.use", "resource": "lmstudio", "effect": "allow" },
    //     { "action": "provider.use", "resource": "amazon-bedrock", "effect": "allow" },
    //     { "action": "provider.use", "resource": "github-copilot", "effect": "allow" },
    //     { "action": "provider.use", "resource": "windows", "effect": "allow" }
    // ],
    // V1 prompted before any access outside the project; V2 allows it by default,
    // so this catch-all restores the prompt before the specific allows below.
    "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "external_directory", "resource": "~/workspace/**", "effect": "allow" },
        { "action": "external_directory", "resource": "~/.cargo/registry/src/**", "effect": "allow" },
        { "action": "external_directory", "resource": "~/notes/**", "effect": "allow" },
        { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
        { "action": "edit", "resource": "~/.aws/**", "effect": "deny" },
        { "action": "edit", "resource": "~/.cargo/**", "effect": "deny" },
        { "action": "edit", "resource": "~/notes/**", "effect": "deny" },
        { "action": "edit", "resource": "/tmp/*", "effect": "allow" }
    ],
    // "model": "github-copilot/claude-sonnet-5.5",
    // "model": "opencode/deepseek-v4.1-flash-free", 
    "providers": {
        // "lmstudio": {
        //     "package": "@opencode/ai/providers/openai-compatible",
        //     "name": "LM Studio (local)",
        //     "settings": {
        //         "baseURL": "http://127.0.0.1:1234/v1"
        //     },
        // },
        "windows": {
            "name": "Windows",
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": {
                "baseURL": "http://192.168.0.138:1234/v1"
            },
            "models": {
                "meta/muse-glimmer": {
                    "name": "Muse Glimmer",
                },
                "deepseek-ai/DeepSeek-V4.1-Flash": {
                    "name": "DeepSeek V4.1 Flash",
                },
                "qwen/qwen3.8-27b": {
                    "name": "Qwen 3.8-27B",
                }
            }
        },
        "amazon-bedrock": {
            "settings": {
                "region": "us-east-1",
                "profile": "claude"
            }
        }
    }
}

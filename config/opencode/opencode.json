{
    "$schema": "https://opencode.ai/config.json",
    "share": "disabled",
    "lsp": true,
    "enabled_providers": ["lmstudio", "amazon-bedrock", "github-copilot", "windows"],
    "permission": {
        "external_directory": {
            "~/workspace/**": "allow",
            "~/.cargo/registry/src/**": "allow",
            "~/notes/**": "allow",
            "/tmp/*": "allow"
        },
        "edit": {
            "~/.cargo/**": "deny",
            "~/notes/**": "deny",
            "/tmp/*": "allow"
        }
    },
    "provider": {
        // "lmstudio": {
        //     "npm": "@ai-sdk/openai-compatible",
        //     "name": "LM Studio (local)",
        //     "options": {
        //         "baseURL": "http://127.0.0.1:1234/v1"
        //     },
        // },
        "windows": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Windows",
            "options": {
                "baseURL": "http://192.168.0.140:1234/v1"
            },
            "models": {
                "qwen/qwen3.8-27b": {
                    "name": "Qwen 3.8-27B",
                }
            }
        },
        "amazon-bedrock": {
            "options": {
                "region": "us-east-1",
                "profile": "claude"
            }
        }
    }
}
